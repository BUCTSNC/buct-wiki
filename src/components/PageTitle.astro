---
import { Badge } from '@astrojs/starlight/components';
import PageEditLink from './PageEditLink.astro';
import PageViews from "./PageViews.astro";
import contributorsByDoc from '../../.output/contributors.json';
import lastModifiedByDoc from '../../.output/last-modified.json';

const { entry } = Astro.locals.starlightRoute;
const tags = entry.data.tags ?? [];
const typeLabels = {
	official: '官方',
	experience: '个人经验',
} as const;
const typeLabel = entry.data.type === 'general' ? undefined : typeLabels[entry.data.type];
type Contributor = { name: string; avatar?: string; profile?: string; commits: number };
const contributors = (contributorsByDoc as Record<string, Contributor[]>)[entry.id] ?? [];
const lastModified = (lastModifiedByDoc as Record<string, string>)[entry.id];
const lastModifiedLabel = lastModified && new Date(lastModified).toLocaleDateString('zh-CN', {
	timeZone: 'Asia/Shanghai',
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
---

<div class="page-heading">
	<h1 id="_top">
		{typeLabel && (
			<span class="type-label">{typeLabel}</span>
		)}
		<span>{entry.data.title}</span>
	</h1>
	<PageEditLink />
</div>

{
	tags.length > 0 && (
		<ul class="article-tags" aria-label="标签">
			{
				tags.map((tag) => (
				<li>
					<a href={`/tags/${encodeURIComponent(tag)}/`} style="text-decoration: none;">
						<Badge text={tag} size="small" />
					</a>
				</li>
			))}
		</ul>
	)
}

<div class="article-meta">
{
	lastModified && (
		<p>
			更新于 <time datetime={lastModified}>{lastModifiedLabel}</time>
		</p>
	)
}

{
	contributors.length > 0 && (
		<div class="contributors" aria-label="本文编辑者">
			<span>编辑者</span>
			<ul>
				{contributors.map((contributor) => (
					<li>
						{contributor.profile ? (
							<a href={contributor.profile} title={`${contributor.name}（${contributor.commits} 次提交）`}>
								<img src={contributor.avatar} alt={contributor.name} width="24" height="24" loading="lazy" />
							</a>
						) : (
							<span
								class="contributor-initial"
								title={`${contributor.name}（${contributor.commits} 次提交）`}
							>
								{contributor.name.slice(0, 1)}
							</span>
						)}
					</li>
				))}
			</ul>
		</div>
	)
}

<PageViews />
</div>

<style>
	.page-heading {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: start;
		gap: 1rem;
		margin-top: 1rem;
	}
	.page-heading h1 {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 0;
		min-width: 0;
		color: var(--md-sys-color-on-surface);
		font-size: var(--sl-text-h1);
		font-weight: 600;
		line-height: var(--sl-line-height-headings);
		text-wrap: balance;
		overflow-wrap: anywhere;
	}
	h1 > span:last-child { min-width: 0; }
	.type-label {
		flex: none;
		padding: 0.25rem 0.5rem;
		border-radius: var(--md-sys-shape-sm);
		background: var(--md-sys-color-secondary-container);
		color: var(--md-sys-color-on-secondary-container);
		font-size: 0.875rem;
		font-weight: 500;
		line-height: 1.5;
	}
	.article-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1rem 0 0; padding: 0; list-style: none; }
	.article-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.5rem;
		margin-top: 1rem;
		color: var(--md-sys-color-on-surface-variant);
		font-size: 0.875rem;
		line-height: 1.5;
	}
	.article-meta p { margin: 0; }
	.contributors, .contributors ul { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
	.contributors ul { margin: 0; padding: 0; list-style: none; }
	.contributors img { display: block; border-radius: var(--md-sys-shape-full); object-fit: cover; }
	.contributor-initial {
		display: grid;
		place-items: center;
		width: 1.5rem;
		height: 1.5rem;
		border-radius: var(--md-sys-shape-full);
		background: var(--md-sys-color-secondary-container);
		color: var(--md-sys-color-on-secondary-container);
	}
	@media (max-width: 35rem) {
		.page-heading h1 { font-size: var(--sl-text-3xl); }
		.article-meta { gap: 0.75rem 1rem; }
	}
</style>
