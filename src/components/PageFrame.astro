---
import DefaultPageFrame from '@astrojs/starlight/components/PageFrame.astro';
import SiteFooter from './SiteFooter.astro';
import sncSymbol from '../assets/snc-symbol.svg';
import sncSymbolWhite from '../assets/snc-symbol-white.svg';

const { hasSidebar, entry } = Astro.locals.starlightRoute;
const leadingTitle = entry.body?.match(/^\s*#\s+([^\n]+?)[ \t]*(?:\r?\n|$)/)?.[1];
const hasRepeatedTitle = !entry.data.hero && leadingTitle === entry.data.title;
---

<div
	class:list={['wiki-frame', { 'has-sidebar': hasSidebar, 'has-repeated-title': hasRepeatedTitle }]}
	style={{ '--snc-symbol': `url("${sncSymbol.src}")`, '--snc-symbol-white': `url("${sncSymbolWhite.src}")` }}
>
	<DefaultPageFrame>
		<slot name="header" slot="header" />
		<slot name="sidebar" slot="sidebar" />
		<slot />
	</DefaultPageFrame>
	<SiteFooter />
</div>

<style>
	/* Show one primary title when the source repeats the page title. */
	.has-repeated-title :global(.sl-markdown-content > :is(h1, .sl-heading-wrapper:has(> h1)):first-child) {
		display: none;
	}
	.has-repeated-title :global(.sl-markdown-content > :is(h1, .sl-heading-wrapper:has(> h1)):first-child + *) {
		margin-top: 0;
	}

	.has-sidebar :global(.main-pane) {
		background-color: var(--md-sys-color-surface);
	}

	/* The footer now begins with guidance that belongs directly after the article. */
	.wiki-frame :global(.sl-markdown-content:has(+ .article-footer)) { padding-bottom: 0; }

	/* Anchor the watermark to the article, independently of expanding footer controls. */
	.wiki-frame :global(.sl-markdown-content:has(+ .article-footer > .content-notices)) {
		position: relative;
		isolation: isolate;
	}
	.wiki-frame :global(.sl-markdown-content:has(+ .article-footer > .content-notices)::after) {
		content: '';
		position: absolute;
		z-index: -1;
		right: 1rem;
		bottom: 0;
		width: clamp(14rem, 26vw, 20rem);
		max-width: 70%;
		max-height: 100%;
		aspect-ratio: 1;
		background: var(--snc-symbol) center / contain no-repeat;
		opacity: 0.045;
		pointer-events: none;
	}
	:global([data-theme='dark']) .wiki-frame :global(.sl-markdown-content:has(+ .article-footer > .content-notices)::after) {
		background-image: var(--snc-symbol-white);
		opacity: 0.1;
	}
	@media (max-width: 49.99rem) {
		.wiki-frame :global(.sl-markdown-content:has(+ .article-footer > .content-notices)::after) {
			right: 0;
			opacity: 0.035;
		}
	}

	@media (min-width: 50rem) {
		.has-sidebar :global(.page) {
			display: grid;
			grid-template-columns: var(--sl-sidebar-width) minmax(0, 1fr);
			padding-top: var(--sl-nav-height);
			align-items: stretch;
		}

		.has-sidebar :global(.page > .sidebar) {
			grid-column: 1;
			grid-row: 1;
			min-width: 0;
		}

		.has-sidebar :global(.sidebar-pane) {
			position: sticky;
			z-index: auto;
			inset: auto;
			top: var(--sl-nav-height);
			width: 100%;
			height: calc(100dvh - var(--sl-nav-height));
		}

		.has-sidebar :global(.main-frame) {
			grid-column: 2;
			grid-row: 1;
			min-width: 0;
			padding-top: 0;
			padding-inline-start: 0;
		}
	}

	@media (min-width: 72rem) {
		.wiki-frame :global(.right-sidebar) {
			position: sticky;
			top: var(--sl-nav-height);
			padding-top: 0;
			height: calc(100dvh - var(--sl-nav-height));
		}
	}
</style>
