{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "buct-wiki",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-20",
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "404-page"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "buct-wiki",
      "database_id": "afa6757e-4b3b-4acb-9bf1-f8820daab528"
    }
  ],
  "previews": {}
}
